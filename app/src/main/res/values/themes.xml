<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Application Theme -->
    <style name="Base.Theme.AETHERWeather"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#101B35</item>
        <item name="android:navigationBarColor">#101B35</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#101B35</item>

    </style>

    <!-- Main Application Theme -->
    <style name="Theme.AETHERWeather"
        parent="Base.Theme.AETHERWeather" />

    <!-- Splash Screen Theme -->
    <style name="Theme.AETHERWeather.Splash"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">#101B35</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_weather_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.AETHERWeather</item>

    </style>

</resources>
